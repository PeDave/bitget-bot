[Unit]
Description=BitgetLab API Service
After=network.target

[Service]
Type=notify
User=root
WorkingDirectory=/root/bitget-bot/src/BitgetLab.Api
ExecStart=/usr/bin/dotnet /root/bitget-bot/src/BitgetLab.Api/bin/Release/net8.0/BitgetLab.Api.dll
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=labot-api
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
