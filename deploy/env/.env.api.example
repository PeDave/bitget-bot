# BitgetLab API Environment Variables
# Copy this file to the appropriate location and fill in the values

# ASP.NET Core Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://localhost:3001

# Bitget API Configuration
# Mode: ReadOnly or Trade
Bitget__Mode=ReadOnly

# ReadOnly Credentials (for market data, monitoring)
Bitget__ReadOnly__ApiKey=your_readonly_api_key_here
Bitget__ReadOnly__ApiSecret=your_readonly_api_secret_here
Bitget__ReadOnly__Passphrase=your_readonly_passphrase_here

# Trade Credentials (for actual trading - use with caution!)
Bitget__Trade__ApiKey=your_trade_api_key_here
Bitget__Trade__ApiSecret=your_trade_api_secret_here
Bitget__Trade__Passphrase=your_trade_passphrase_here

# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# CORS (if needed)
# AllowedOrigins=https://labotkripto.com,http://localhost:3000
