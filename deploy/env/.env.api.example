# BitgetLab API Environment Variables
# Copy this file to the appropriate location and fill in the values

# ASP.NET Core Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://localhost:3001

# Bitget API Configuration
# Mode: ReadOnly or Trade
# - ReadOnly: Only allows read operations (market data, account info)
# - Trade: Allows trading operations (place orders, cancel orders, etc.)
# IMPORTANT: Start with ReadOnly mode for testing!
Bitget__Mode=ReadOnly

# ReadOnly Credentials (for market data, monitoring)
# Create a ReadOnly API key on Bitget with only read permissions
Bitget__ReadOnly__ApiKey=your_readonly_api_key_here
Bitget__ReadOnly__ApiSecret=your_readonly_api_secret_here
Bitget__ReadOnly__Passphrase=your_readonly_passphrase_here

# Trade Credentials (for actual trading - use with extreme caution!)
# Create a separate Trade API key on Bitget with trading permissions
# IMPORTANT: 
# - Only enable this in production after thorough testing
# - Use IP whitelisting on Bitget for additional security
# - Start with small amounts
Bitget__Trade__ApiKey=your_trade_api_key_here
Bitget__Trade__ApiSecret=your_trade_api_secret_here
Bitget__Trade__Passphrase=your_trade_passphrase_here

# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# CORS (if needed)
# AllowedOrigins=https://labotkripto.com,http://localhost:3000

# Notes:
# 1. Never commit this file with real credentials
# 2. Use different API keys for ReadOnly and Trade modes
# 3. Enable IP whitelisting on Bitget for your VPS IP address
# 4. Test all endpoints in ReadOnly mode first
# 5. POST /api/bitget/orders will return 403 if Mode=ReadOnly
