# BitgetLab Caddy Configuration Snippet
# Add this to your main Caddyfile or include it

# API endpoint
api.labotkripto.com {
    reverse_proxy localhost:3001
    
    log {
        output file /var/log/caddy/api.labotkripto.com.log
    }
}

# Main web app
labotkripto.com {
    reverse_proxy localhost:3000
    
    log {
        output file /var/log/caddy/labotkripto.com.log
    }
}

www.labotkripto.com {
    redir https://labotkripto.com{uri} permanent
}

# n8n workflow automation
n8n.labotkripto.com {
    reverse_proxy localhost:5678
    
    log {
        output file /var/log/caddy/n8n.labotkripto.com.log
    }
}
