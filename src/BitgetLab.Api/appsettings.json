{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:3001",
  "ConnectionStrings": {
    "PostgreSQL": ""
  },
  "Charting": {
    "EnablePersistence": false,
    "BufferSize": 500,
    "EnableGapDetection": true
  },
  "BacktestApi": {
    "ApiKey": "",
    "MaxTimeRangeDays": 730
  },
  "Bitget": {
    "Mode": "ReadOnly",
    "ReadOnly": {
      "ApiKey": "",
      "ApiSecret": "",
      "Passphrase": ""
    },
    "Trade": {
      "ApiKey": "",
      "ApiSecret": "",
      "Passphrase": ""
    },
    "Futures": {
      "ProductType": "usdt-futures",
      "PublicRestBaseUrl": "https://api.bitget.com",
      "Pipeline": {
        "Enabled": true,
        "WsIntervals": ["15m", "30m", "1h"],
        "RestIntervals": ["4h", "1d"],
        "SyncEveryMinutes": 30,
        "MaxRows": 10000,
        "LookbackDays": {
          "15m": 45,
          "30m": 90,
          "1h": 180,
          "4h": 365,
          "1d": 730
        }
      }
    }
  }
}
